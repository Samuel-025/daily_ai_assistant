# ══════════════════════════════════════════════════
#   Daily AI Assistant — Environment Configuration
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your values
#   3. Run:  python main.py --setup   (recommended)
# ══════════════════════════════════════════════════

# ── App Behaviour ───────────────────────────────────────────
# IMPORTANT: Must be one of: ollama | openai | anthropic | groq | cohere
# Do NOT put an API key here — put the provider NAME only
DEFAULT_PROVIDER=groq

# Use local Ollama before falling back to cloud providers
USE_LOCAL_FIRST=false

# ── Location (for weather module) ───────────────────────────
USER_CITY=Vasind
USER_COUNTRY=IN

# ── Ollama (Local LLM — FREE, runs on your machine) ────────────
OLLAMA_API_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
# Setup: https://ollama.ai/download  then run: ollama pull llama3.2

# ── Groq (Recommended — fast, free tier) ────────────────────
# Get free key: https://console.groq.com/
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ── OpenAI ────────────────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# ── Anthropic Claude ──────────────────────────────────────
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ── Cohere ────────────────────────────────────────────────
# Get key: https://dashboard.cohere.com/
COHERE_API_KEY=
COHERE_DEFAULT_MODEL=command-a-03-2025

# ── Optional APIs ──────────────────────────────────────────
# Real weather data: https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=
# News headlines: https://newsapi.org/ (free tier)
NEWS_API_KEY=
