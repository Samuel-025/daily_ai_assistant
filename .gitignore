# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/

# Environment — NEVER commit real .env
.env
.venv
env/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ============================================
# SECRETS — NEVER commit these
# ============================================
.streamlit/secrets.toml
*.secret
*.secrets

# ============================================
# USER DATA — local only, NEVER commit these
# ============================================

# Block ALL .json in data folders ...
preferences/*.json
tasks/*.json
habits/*.json
journal/*.json
meals/*.json
reminders/*.json
demo_data/*.json

# ... but ALLOW .example.json files (safe templates)
!preferences/*.example.json
!tasks/*.example.json
!habits/*.example.json
!journal/*.example.json
!meals/*.example.json
!reminders/*.example.json

# Logs
*.log
app.log
